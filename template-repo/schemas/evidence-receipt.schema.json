{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_id", "gate_id", "producer", "invocation", "subject", "artifacts", "observations", "behavioral_probes", "result", "started_at", "timestamp"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["gate", "test_suite", "runtime_health", "security_review", "finding_verification", "phase_closeout", "release"]},
    "evidence_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "model", "service", "workflow"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "workflow"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "path", "job", "run_id", "run_attempt"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "job": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "run_attempt": {"type": "string", "minLength": 1},
            "matrix": {"type": "object"}
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "binding", "tracked_clean"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "binding": {"enum": ["exact_tree", "tree_independent"]},
        "tracked_clean": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "observations": {"type": "object"},
    "behavioral_probes": {"type": "array"},
    "result": {"enum": ["passed", "failed"]},
    "freshness_limit_seconds": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1}
  }
}
