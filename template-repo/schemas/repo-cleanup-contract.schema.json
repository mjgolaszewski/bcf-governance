{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "intent",
    "canonical_roots",
    "drift_patterns",
    "deterministic_actions",
    "llm_review_required",
    "validation_required",
    "evidence_required",
    "closeout_rules"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "generated_at_utc", "status", "path"],
      "properties": {
        "kind": { "type": "string", "const": "repo_cleanup_contract" },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generated_at_utc": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "superseded"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "intent": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_governance", "historical_evidence", "documentation", "tests", "ephemeral_evidence"],
      "properties": {
        "active_governance": { "$ref": "#/$defs/path_list" },
        "historical_evidence": { "$ref": "#/$defs/path_list" },
        "documentation": { "$ref": "#/$defs/path_list" },
        "tests": { "$ref": "#/$defs/path_list" },
        "ephemeral_evidence": { "$ref": "#/$defs/path_list" }
      }
    },
    "drift_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "detect", "action", "deterministic", "llm_review"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "detect": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "deterministic": { "type": "boolean" },
          "llm_review": { "type": "string", "enum": ["none", "optional", "required"] }
        }
      }
    },
    "deterministic_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "applies_when", "safety", "outputs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "applies_when": { "type": "string", "minLength": 1 },
          "safety": { "type": "string", "minLength": 1 },
          "outputs": { "$ref": "#/$defs/string_list" }
        }
      }
    },
    "llm_review_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "required_output"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "required_output": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "status_policy"],
      "properties": {
        "commands": { "$ref": "#/$defs/string_list" },
        "status_policy": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_required": { "$ref": "#/$defs/string_list" },
    "closeout_rules": { "$ref": "#/$defs/string_list" }
  },
  "$defs": {
    "path_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
