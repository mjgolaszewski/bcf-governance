{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "target_profile", "gates", "gate_catalog", "provenance"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "path"],
      "properties": {
        "kind": {"const": "gate_contract_registry"},
        "version": {"const": "1.0"},
        "path": {"const": "governance/gate-contracts.yml"}
      }
    },
    "schema_version": {"const": "1.0"},
    "target_profile": {"enum": ["lite", "standard", "regulated"]},
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "gate_catalog": {"type": "object", "minProperties": 1},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "evidence", "negative_controls"],
      "properties": {
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "cwd", "env", "required_env"],
          "properties": {
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "cwd": {"type": "string", "minLength": 1},
            "env": {"type": "object", "additionalProperties": {"type": "string"}},
            "required_env": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "evidence": {"type": "object"},
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mutation", "oracle"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "mutation": {"type": "object"},
              "oracle": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
