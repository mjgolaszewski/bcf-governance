{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "phase",
    "summary",
    "workitems",
    "execution_evidence",
    "closeout_requirements",
    "known_constraints",
    "next_work"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "generated_at_utc", "status", "path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generated_at_utc": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["planned", "completed"]
        },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "build_block"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "build_block": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "highlights"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workitems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "execution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_commands", "executed_commands", "notes"],
      "properties": {
        "planned_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "executed_commands": {
          "type": "array"
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "closeout_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "reconciliation", "finding_registry"],
      "properties": {
        "claims": {
          "type": "object",
          "required": ["workitems_closed", "required_suites_green", "architecture_gates_green", "health_checks_green", "security_review_complete", "findings_resolved"],
          "additionalProperties": false,
          "properties": {
            "workitems_closed": { "$ref": "#/$defs/evidenceRequirement" },
            "required_suites_green": { "$ref": "#/$defs/evidenceRequirement" },
            "architecture_gates_green": { "$ref": "#/$defs/evidenceRequirement" },
            "health_checks_green": { "$ref": "#/$defs/evidenceRequirement" },
            "security_review_complete": { "$ref": "#/$defs/evidenceRequirement" },
            "findings_resolved": { "$ref": "#/$defs/evidenceRequirement" }
          }
        },
        "reconciliation": { "$ref": "#/$defs/evidenceRequirement" },
        "finding_registry": { "type": "string", "const": "governance/findings.yml" }
      }
    },
    "known_warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "known_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_work": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_evidence"],
      "properties": {
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
