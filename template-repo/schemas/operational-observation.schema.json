{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "authority", "execution_id", "sequence", "stage", "state", "monotonic_ms"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "prospective_progress"},
        "authority": {"const": false},
        "execution_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "stage": {"type": "string", "minLength": 1},
        "state": {"enum": ["started", "complete", "failed"]},
        "monotonic_ms": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "authority", "repository", "run_id", "run_attempt", "job_id", "runner_labels", "provider_queue_ms", "execution_ms"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "provider_queue"},
        "authority": {"const": false},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "job_id": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "unknown"}]},
        "runner_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "provider_queue_ms": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "execution_ms": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "authority", "train_id", "subject", "counters", "wall_clock_ms", "compute_ms"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "governance_amplification"},
        "authority": {"const": false},
        "train_id": {"type": "string", "minLength": 1},
        "subject": {"type": "object", "additionalProperties": false, "required": ["commit_sha", "tree_sha"], "properties": {"commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
        "counters": {"type": "object"},
        "wall_clock_ms": {"type": "integer", "minimum": 0},
        "compute_ms": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "authority", "phase_id", "completed_prefix", "predecessor", "current", "successor", "history_owner"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "kind": {"const": "lifecycle_projection"},
        "authority": {"const": "lifecycle"},
        "phase_id": {"type": "string", "minLength": 1},
        "completed_prefix": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "predecessor": {"type": ["string", "null"]},
        "current": {"type": ["string", "null"]},
        "successor": {"type": ["string", "null"]},
        "history_owner": {"const": "plans/phase-history.yml"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "authority",
        "subject",
        "pipeline",
        "clock_id",
        "clock_basis",
        "start_ms",
        "end_ms",
        "elapsed_ms",
        "execution_union_ms",
        "execution_sum_ms",
        "external_wait_union_ms",
        "uncovered_ms",
        "cpu_ms",
        "intervals",
        "repository",
        "repository_id",
        "source_snapshot_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "pipeline_timing"
        },
        "authority": {
          "const": false
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit_sha",
            "tree_sha"
          ],
          "properties": {
            "commit_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "tree_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "pipeline": {
          "enum": [
            "pr",
            "exact_main",
            "controller",
            "release",
            "adopter",
            "publication_to_custody",
            "dispatch_to_custody",
            "merge_to_custody",
            "periodic",
            "developer_interruption"
          ]
        },
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_basis": {
          "enum": [
            "provider_utc_ms",
            "monotonic_ms"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "execution_union_ms": {
          "type": "integer",
          "minimum": 0
        },
        "execution_sum_ms": {
          "type": "integer",
          "minimum": 0
        },
        "external_wait_union_ms": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "unknown"
            }
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "clock_id",
              "kind",
              "status",
              "start_ms",
              "end_ms"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "clock_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "execution",
                  "external_wait"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "cancelled",
                  "superseded",
                  "completed",
                  "skipped"
                ]
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "cpu_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "source_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  ]
}
