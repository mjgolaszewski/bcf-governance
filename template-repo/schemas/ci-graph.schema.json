{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcf-governance.invalid/schemas/ci-graph.schema.json",
  "title": "BCF CI graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "provider", "profile_contract_version", "default_branch", "trusted_controller", "value_sources", "extension_points", "extensions", "resource_classes", "artifacts", "conditions", "commands", "step_components", "workflows", "policy"],
  "properties": {
    "document": {"$ref": "#/$defs/document"},
    "schema_version": {"const": "1.0"},
    "provider": {"const": "github"},
    "profile_contract_version": {"enum": ["1.0", "2.0"]},
    "default_branch": {"$ref": "#/$defs/identifier"},
    "trusted_controller": {"$ref": "#/$defs/trustedController"},
    "value_sources": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/valueSource"}
    },
    "extension_points": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"enum": ["preflight", "evidence-lane", "before-truth", "after-truth", "exact-main-producer", "trusted-control", "scheduled-lane", "release-role"]}
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/extensionReference"}
    },
    "resource_classes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/resourceClass"}
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "conditions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/conditionExpression"}
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/command"}
    },
    "step_components": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/stepComponent"}
    },
    "workflows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workflow"}},
    "policy": {"$ref": "#/$defs/policy"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runnerLabel": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "string", "pattern": "^\\$\\{\\{ matrix\\.[A-Za-z0-9][A-Za-z0-9._-]* \\}\\}$"}]},
    "trustedController": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "executable"],
          "properties": {
            "kind": {"const": "executable"},
            "executable": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policy_path"],
          "properties": {
            "kind": {"const": "self_governance_policy"},
            "policy_path": {"const": "governance/self-governance-policy.yml"}
          }
        }
      ]
    },
    "valueSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"const": "yaml"},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "status", "path"],
      "properties": {
        "kind": {"const": "ci_graph"},
        "name": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"const": "active"},
        "path": {"const": "governance/ci-graph.yml"}
      }
    },
    "extensionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^governance/ci-extensions/[A-Za-z0-9._-]+\\.ya?ml$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resourceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "trust", "hosted", "capabilities"],
      "properties": {
        "runner": {"oneOf": [{"$ref": "#/$defs/runnerLabel"}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/runnerLabel"}}]},
        "trust": {"enum": ["candidate", "trusted"]},
        "hosted": {"type": "boolean"},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "scope", "retention_days"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "kind": {"enum": ["session", "lane-input", "terminal", "control", "release"]},
        "scope": {"const": "run-attempt"},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 90}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "#/$defs/safePath"},
        "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"type": "string"}},
        "required_environment": {"type": "array", "uniqueItems": true, "items": {"pattern": "^[A-Z_][A-Z0-9_]*$"}}
      }
    },
    "conditionExpression": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:always|success|failure|cancelled)\\(\\)(?:[ ]*(?:&&|\\|\\|)[ ]*(?:!?[A-Za-z0-9_.-]+|[A-Za-z0-9_.-]+[ ]*(?:==|!=)[ ]*(?:true|false|'[A-Za-z0-9_./:-]+')))*$|^(?:!?[A-Za-z0-9_.-]+|[A-Za-z0-9_.-]+[ ]*(?:==|!=)[ ]*(?:true|false|'[A-Za-z0-9_./:-]+'))(?:[ ]*(?:&&|\\|\\|)[ ]*(?:!?[A-Za-z0-9_.-]+|[A-Za-z0-9_.-]+[ ]*(?:==|!=)[ ]*(?:true|false|'[A-Za-z0-9_./:-]+')))*$"
    },
    "scalar": {"type": ["string", "boolean", "integer"]},
    "stepComponent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "action", "with", "environment", "produces", "consumes"],
          "properties": {
            "kind": {"const": "action"},
            "name": {"type": "string", "minLength": 1},
            "id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
            "condition": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
            "action": {"enum": ["checkout", "setup-python", "upload-artifact", "download-artifact", "attest-build-provenance"]},
            "with": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}},
            "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"type": "string"}},
            "produces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "consumes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "command", "environment", "produces", "consumes"],
          "properties": {
            "kind": {"const": "command"},
            "name": {"type": "string", "minLength": 1},
            "id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
            "condition": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
            "command": {"$ref": "#/$defs/identifier"},
            "restores_private_artifacts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"type": "string"}},
            "produces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "consumes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "artifact_dir", "install_root", "produces", "consumes"],
          "oneOf": [
            {"required": ["wheel_sha256"], "not": {"anyOf": [{"required": ["wheel_sha256_file"]}, {"required": ["wheel_sha256_key"]}]}},
            {"required": ["wheel_sha256_file", "wheel_sha256_key"], "not": {"required": ["wheel_sha256"]}}
          ],
          "properties": {
            "kind": {"const": "controller_install"},
            "name": {"type": "string", "minLength": 1},
            "artifact_dir": {"type": "string", "minLength": 1},
            "install_root": {"type": "string", "minLength": 1},
            "wheel_sha256": {"$ref": "#/$defs/sha256"},
            "wheel_sha256_file": {"type": "string", "minLength": 1},
            "wheel_sha256_key": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
            "produces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "consumes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "paths", "produces", "consumes"],
          "properties": {
            "kind": {"const": "directory_setup"},
            "name": {"type": "string", "minLength": 1},
            "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
            "produces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "consumes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["pull_request", "push", "workflow_call", "workflow_dispatch", "workflow_run", "schedule", "repository_dispatch"]},
        "branches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "cron": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "workflows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        ,"inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "required", "default", "type"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "default": {"$ref": "#/$defs/scalar"},
              "type": {"enum": ["string", "boolean", "choice"]},
              "options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "permissionMap": {
      "type": "object",
      "propertyNames": {"enum": ["actions", "attestations", "checks", "contents", "id-token", "packages", "pull-requests", "security-events", "statuses"]},
      "additionalProperties": {"enum": ["none", "read", "write"]}
    },
    "executor": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "command"], "properties": {"kind": {"const": "command"}, "command": {"$ref": "#/$defs/identifier"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "gates"], "properties": {"kind": {"const": "gate_group"}, "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "reusable_workflow"}, "path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"}, "inputs": {"type": "object"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "operation"], "properties": {"kind": {"const": "authority"}, "operation": {"enum": ["admit", "finalize", "publish", "authorize-release", "collect-release", "publish-release"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "components"], "properties": {"kind": {"const": "component_sequence"}, "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "gates", "shard_key", "shard_count", "components"], "properties": {"kind": {"const": "gate_shard"}, "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "shard_key": {"$ref": "#/$defs/identifier"}, "shard_count": {"type": "integer", "minimum": 2, "maximum": 256}, "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "command", "components"], "properties": {"kind": {"const": "terminal_truth"}, "command": {"$ref": "#/$defs/identifier"}, "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "command"], "properties": {"kind": {"const": "truth"}, "command": {"$ref": "#/$defs/identifier"}}}
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "semantic_role", "resource_class", "trust", "needs", "condition", "timeout_minutes", "permissions", "checkout", "components", "executor", "produces", "consumes", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "semantic_role": {"$ref": "#/$defs/identifier"},
        "resource_class": {"$ref": "#/$defs/identifier"},
        "trust": {"enum": ["candidate", "trusted"]},
        "needs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "condition": {"$ref": "#/$defs/identifier"},
        "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 360},
        "permissions": {"$ref": "#/$defs/permissionMap"},
        "checkout": {"type": "boolean"},
        "components": {"type": "array", "uniqueItems": true, "items": {"enum": ["checkout", "python", "governance-dependencies", "download-evidence", "upload-evidence", "restore-private-modes", "scoped-cleanup"]}},
        "executor": {"$ref": "#/$defs/executor"},
        "produces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "consumes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "matrix": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true}},
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fail_fast", "matrix"],
          "properties": {
            "fail_fast": {"type": "boolean"},
            "max_parallel": {"type": "integer", "minimum": 1, "maximum": 256},
            "matrix": {"type": "object", "minProperties": 1}
          }
        },
        "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"type": "string"}},
        "outputs": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"type": "string", "pattern": "^\\$\\{\\{ steps\\.[A-Za-z0-9_.-]+\\.outputs\\.[A-Za-z0-9_.-]+ \\}\\}$"}},
        "controller_requirement": {"enum": ["current", null]},
        "required": {"type": "boolean"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "display_name", "role", "events", "permissions", "jobs"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"},
        "display_name": {"type": "string", "minLength": 1},
        "role": {"enum": ["pull-request", "exact-main", "scheduled", "release", "trusted-control", "custom"]},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
        "permissions": {"$ref": "#/$defs/permissionMap"},
        "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"type": "string"}},
        "concurrency": {"type": "object", "additionalProperties": false, "required": ["group", "cancel_in_progress"], "properties": {"group": {"type": "string", "minLength": 1}, "cancel_in_progress": {"type": "boolean"}}},
        "jobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/job"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_gate_once", "complete_evidence_fan_in", "single_push_authority", "generated_workflows_only", "forbid_hosted_waiters", "forbidden_hosted_tokens"],
      "properties": {
        "exact_gate_once": {"const": true},
        "complete_evidence_fan_in": {"const": true},
        "single_push_authority": {"const": true},
        "generated_workflows_only": {"const": true},
        "forbid_hosted_waiters": {"const": true},
        "forbidden_hosted_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
