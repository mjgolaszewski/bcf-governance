{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcf-governance.invalid/schemas/evidence-input-manifest.schema.json",
  "title": "BCF content-addressed evidence input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "namespace", "storage_contract_sha256", "subject", "producer", "created_at_utc", "objects", "total_archive_bytes", "total_expanded_bytes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "governance.evidence-input-manifest.v1"},
    "namespace": {"$ref": "#/$defs/identifier"},
    "storage_contract_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {"$ref": "#/$defs/subject"},
    "producer": {"$ref": "#/$defs/producer"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "objects": {"type": "array", "minItems": 1, "maxItems": 999, "items": {"$ref": "#/$defs/object"}},
    "total_archive_bytes": {"type": "integer", "minimum": 1},
    "total_expanded_bytes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "commit_sha", "tree_sha"],
      "properties": {
        "repository_id": {"type": "integer", "minimum": 1},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workflow_path", "workflow_sha256", "job_id", "job_name", "run_id", "run_attempt"],
      "properties": {
        "kind": {"enum": ["workflow", "local_fixture"]},
        "workflow_path": {"oneOf": [{"$ref": "#/$defs/safePath"}, {"type": "null"}]},
        "workflow_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "job_id": {"$ref": "#/$defs/identifier"},
        "job_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mode", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "kind": {"enum": ["file", "directory"]},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "observed_at_utc"],
      "properties": {
        "class": {"$ref": "#/$defs/identifier"},
        "observed_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_path", "root_kind", "asset_name", "media_type", "archive_sha256", "archive_size", "expanded_size", "members", "freshness"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "target_path": {"$ref": "#/$defs/safePath"},
        "root_kind": {"enum": ["file", "directory"]},
        "asset_name": {"type": "string", "pattern": "^sha256-[a-f0-9]{64}\\.tar\\.gz$"},
        "media_type": {"const": "application/vnd.bcf.evidence-input.tar+gzip"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "archive_size": {"type": "integer", "minimum": 1},
        "expanded_size": {"type": "integer", "minimum": 0},
        "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
        "freshness": {"$ref": "#/$defs/freshness"}
      }
    }
  }
}
