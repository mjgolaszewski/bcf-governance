{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "families", "migrations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "status", "path"],
      "properties": {
        "kind": {"const": "semantic_family_registry"},
        "id": {"type": "string", "minLength": 1},
        "version": {"const": "1.0.0"},
        "status": {"const": "active"},
        "path": {"const": "governance/semantic-families.yml"}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    },
    "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "semanticId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+\\.v[1-9][0-9]*$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_paths", "symbols"],
      "properties": {
        "source_paths": {"$ref": "#/$defs/stringArray"},
        "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "::"}},
        "secondary_paths": {"$ref": "#/$defs/stringArray"}
      }
    },
    "responsibilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction", "decoding", "transition", "projection"],
      "properties": {
        "construction": {"$ref": "#/$defs/stringArray"},
        "decoding": {"$ref": "#/$defs/stringArray"},
        "transition": {"$ref": "#/$defs/stringArray"},
        "projection": {"$ref": "#/$defs/stringArray"}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "significance", "ownership_required", "canonical_semantic_ids", "material_selectors", "responsibilities"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "significance": {"enum": ["authoritative", "projection", "descriptive"]},
        "ownership_required": {"type": "boolean"},
        "canonical_semantic_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/semanticId"}},
        "material_selectors": {"$ref": "#/$defs/selectors"},
        "responsibilities": {"$ref": "#/$defs/responsibilities"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind", "subject_id", "change", "base_sha", "previous_sha256", "current_sha256", "owner", "reason"],
      "properties": {
        "subject_kind": {"enum": ["family", "operation", "representation"]},
        "subject_id": {"type": "string", "minLength": 1},
        "change": {"enum": ["retired", "downgraded", "reassigned", "semantic_kind_changed", "effect_changed", "recipe_changed", "exception_changed"]},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "previous_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "current_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
