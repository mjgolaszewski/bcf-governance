{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in Python source call facts 1.0; observations only",
  "$defs": {
    "call_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "expression_sha256",
        "occurrence",
        "arguments"
      ],
      "properties": {
        "authority": {
          "const": false
        },
        "expression_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "slot",
              "expression_sha256"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "positional",
                  "starred",
                  "keyword",
                  "double_starred"
                ]
              },
              "slot": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "expression_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "keyword"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "slot": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "slot": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "language",
    "call_contracts_version",
    "authority",
    "functions"
  ],
  "properties": {
    "language": {
      "const": "python"
    },
    "call_contracts_version": {
      "const": "1.0"
    },
    "authority": {
      "const": false
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "calls"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "call_contract"
              ],
              "properties": {
                "call_contract": {
                  "$ref": "#/$defs/call_contract"
                }
              }
            }
          }
        }
      }
    }
  }
}
