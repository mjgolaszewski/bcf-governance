          "properties": {
            "status": {
              "const": "required_before_implementation"
            },
            "scenario": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "negative_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scenario"
