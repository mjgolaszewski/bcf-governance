include AGENTS.md AGENTS.yml CHANGELOG.md CLAUDE.md LICENSE MEMORY.yml Makefile.fragment README.md
include architecture-boundaries.yml governance-profile.yml manifest.yml requirements-governance.txt
global-exclude __pycache__ *.py[cod]
