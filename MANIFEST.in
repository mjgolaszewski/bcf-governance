recursive-include bcf_governance/pack/template-repo *
recursive-include docs/assets *
recursive-include template-repo *
recursive-include tests *
recursive-include examples *
recursive-include scripts *.py
recursive-include .github/scripts *.py
recursive-include .github/workflows *.yml *.yaml
recursive-include audits *.md *.yml *.yaml *.json
recursive-include contracts *.md *.yml *.yaml *.json
recursive-include governance *.md *.yml *.yaml *.json
include governance/archive/phase-artifacts/.gitkeep
recursive-include phases *.md *.yml *.yaml *.json
recursive-include plans *.md *.yml *.yaml *.json
