{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcf-governance.invalid/schemas/ci-workflow-inventory.schema.json",
  "title": "BCF imported GitHub workflow inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "provider", "subject", "workflows"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "status", "path"],
      "properties": {
        "kind": {"const": "ci_workflow_inventory"},
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"const": "derived"},
        "path": {"const": "governance/ci-workflow-inventory.yml"}
      }
    },
    "schema_version": {"const": "1.0"},
    "provider": {"const": "github"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "name", "events", "permissions", "concurrency", "jobs"],
        "properties": {
          "path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "name": {"type": "string", "minLength": 1},
          "events": {"type": "object"},
          "permissions": {},
          "concurrency": {},
          "jobs": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
