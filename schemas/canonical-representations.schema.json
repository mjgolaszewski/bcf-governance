{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "enforcement", "source_authority", "representations"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "status", "path"],
      "properties": {
        "kind": {"const": "canonical_representation_registry"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "active"},
        "path": {"const": "governance/canonical-representations.yml"}
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "default_mode", "declared_families", "blocking_semantic_ids", "report_path", "unresolved_dynamic_policy"],
      "properties": {
        "phase": {"type": "string", "pattern": "^P[0-9]+$"},
        "default_mode": {"enum": ["report_only", "declared_families_blocking", "repository_wide_blocking"]},
        "declared_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
        "blocking_semantic_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semanticId"}},
        "report_path": {"const": ".artifacts/semantic-ownership/report.json"},
        "unresolved_dynamic_policy": {"enum": ["report", "fail_closed"]}
      }
    },
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_precedes_registry_load", "python_engine", "typescript_engine", "cross_language_trace", "completeness_authority", "authoritative_python_roots", "generated_mirror_roots"],
      "properties": {
        "discovery_precedes_registry_load": {"const": true},
        "python_engine": {"type": "string", "minLength": 1},
        "typescript_engine": {"type": "string", "minLength": 1},
        "cross_language_trace": {"type": "string", "minLength": 1},
        "completeness_authority": {"const": "independent_exact_tree_source_inventory"},
        "authoritative_python_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "generated_mirror_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/representation"}
    }
  },
  "$defs": {
    "semanticId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+\\.v[1-9][0-9]*$"},
    "symbol": {"type": "string", "minLength": 1, "pattern": "::"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fieldInvariant": {
      "type": "object", "additionalProperties": false, "required": ["field", "invariant"],
      "properties": {"field": {"type": "string", "minLength": 1}, "invariant": {"type": "string", "minLength": 1}}
    },
    "defaultRule": {
      "type": "object", "additionalProperties": false, "required": ["field", "value", "owner"],
      "properties": {"field": {"type": "string", "minLength": 1}, "value": {}, "owner": {"$ref": "#/$defs/symbol"}}
    },
    "aliasRule": {
      "type": "object", "additionalProperties": false, "required": ["alias", "primary", "decoder"],
      "properties": {"alias": {"type": "string", "minLength": 1}, "primary": {"type": "string", "minLength": 1}, "decoder": {"$ref": "#/$defs/symbol"}}
    },
    "translation": {
      "type": "object", "additionalProperties": false, "required": ["symbol", "source_semantic_id", "protocol_variant", "destination_semantic_id"],
      "properties": {"symbol": {"$ref": "#/$defs/symbol"}, "source_semantic_id": {"$ref": "#/$defs/semanticId"}, "protocol_variant": {"type": "string", "minLength": 1}, "destination_semantic_id": {"$ref": "#/$defs/semanticId"}}
    },
    "projection": {
      "type": "object", "additionalProperties": false, "required": ["source_semantic_id", "destination_semantic_id", "owner", "lost_fields", "reason"],
      "properties": {"source_semantic_id": {"$ref": "#/$defs/semanticId"}, "destination_semantic_id": {"$ref": "#/$defs/semanticId"}, "owner": {"$ref": "#/$defs/symbol"}, "lost_fields": {"$ref": "#/$defs/stringArray"}, "reason": {"type": "string", "minLength": 1}}
    },
    "suppression": {
      "type": "object", "additionalProperties": false, "required": ["reason", "accountable_owner", "symbol", "rule", "issue", "expires_on", "runtime_guard", "causal_fixture"],
      "properties": {
        "reason": {"type": "string", "minLength": 1}, "accountable_owner": {"type": "string", "minLength": 1},
        "symbol": {"$ref": "#/$defs/symbol"}, "rule": {"type": "string", "minLength": 1}, "issue": {"type": "string", "minLength": 1},
        "expires_on": {"type": "string", "format": "date"}, "runtime_guard": {"type": "string", "minLength": 1}, "causal_fixture": {"type": "string", "minLength": 1}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_id", "family", "schema_version", "lifecycle", "finding_ids", "canonical_type", "authoritative_owner",
        "authorized_constructors_and_factories", "authorized_pure_delegates", "hostile_boundary_decoder", "field_invariants",
        "permitted_defaults_and_single_application_point", "accepted_aliases_and_single_ingress_boundary", "persistence_codec_and_envelope",
        "protocol_translations", "intentional_projections", "declared_consumer_layers_and_sinks", "generated_source_authority",
        "migration_policy", "narrow_suppressions"
      ],
      "properties": {
        "semantic_id": {"$ref": "#/$defs/semanticId"},
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "schema_version": {"type": "integer", "minimum": 1},
        "lifecycle": {"enum": ["planned", "enforced"]},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_type": {"type": "object", "additionalProperties": false, "required": ["language", "symbol"], "properties": {"language": {"enum": ["python", "typescript", "cross_language", "governance"]}, "symbol": {"$ref": "#/$defs/symbol"}}},
        "authoritative_owner": {"type": "object", "additionalProperties": false, "required": ["symbol", "owner_kind"], "properties": {"symbol": {"$ref": "#/$defs/symbol"}, "owner_kind": {"enum": ["hostile_decoder", "constructor", "codec", "projection", "inventory_decoder", "analyzer"]}}},
        "authorized_constructors_and_factories": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
        "authorized_pure_delegates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
        "hostile_boundary_decoder": {"type": "object", "additionalProperties": false, "required": ["symbol", "trust_boundary"], "properties": {"symbol": {"$ref": "#/$defs/symbol"}, "trust_boundary": {"type": "string", "minLength": 1}}},
        "field_invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldInvariant"}},
        "permitted_defaults_and_single_application_point": {"type": "array", "items": {"$ref": "#/$defs/defaultRule"}},
        "accepted_aliases_and_single_ingress_boundary": {"type": "array", "items": {"$ref": "#/$defs/aliasRule"}},
        "persistence_codec_and_envelope": {
          "type": "object", "additionalProperties": false, "required": ["applicability", "codec_symbol", "semantic_id", "schema_version", "exact_byte_format", "integrity_algorithm", "identity_bindings", "migration_dispatch"],
          "properties": {"applicability": {"enum": ["not_applicable", "planned", "required"]}, "codec_symbol": {"$ref": "#/$defs/symbol"}, "semantic_id": {"$ref": "#/$defs/semanticId"}, "schema_version": {"type": "integer", "minimum": 1}, "exact_byte_format": {"type": "string", "minLength": 1}, "integrity_algorithm": {"type": "string", "minLength": 1}, "identity_bindings": {"$ref": "#/$defs/stringArray"}, "migration_dispatch": {"type": "string", "minLength": 1}}
        },
        "protocol_translations": {"type": "array", "items": {"$ref": "#/$defs/translation"}},
        "intentional_projections": {"type": "array", "items": {"$ref": "#/$defs/projection"}},
        "declared_consumer_layers_and_sinks": {
          "type": "object", "additionalProperties": false, "required": ["read", "authorization", "persistence", "cache", "queue", "network", "api", "browser"],
          "properties": {"read": {"$ref": "#/$defs/stringArray"}, "authorization": {"$ref": "#/$defs/stringArray"}, "persistence": {"$ref": "#/$defs/stringArray"}, "cache": {"$ref": "#/$defs/stringArray"}, "queue": {"$ref": "#/$defs/stringArray"}, "network": {"$ref": "#/$defs/stringArray"}, "api": {"$ref": "#/$defs/stringArray"}, "browser": {"$ref": "#/$defs/stringArray"}}
        },
        "generated_source_authority": {
          "type": "object", "additionalProperties": false, "required": ["authoritative_roots", "generated_mirrors", "generator", "parity_proof"],
          "properties": {"authoritative_roots": {"$ref": "#/$defs/stringArray"}, "generated_mirrors": {"$ref": "#/$defs/stringArray"}, "generator": {"type": "string", "minLength": 1}, "parity_proof": {"type": "string", "minLength": 1}}
        },
        "migration_policy": {
          "type": "object", "additionalProperties": false, "required": ["source_versions", "destination_version", "owner", "runtime_exclusion", "removal_condition"],
          "properties": {"source_versions": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "destination_version": {"type": "integer", "minimum": 1}, "owner": {"$ref": "#/$defs/symbol"}, "runtime_exclusion": {"type": "string", "minLength": 1}, "removal_condition": {"type": "string", "minLength": 1}}
        },
        "narrow_suppressions": {"type": "array", "items": {"$ref": "#/$defs/suppression"}}
      }
    }
  }
}
