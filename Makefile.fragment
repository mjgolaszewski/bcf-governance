SHELL := /bin/bash
PYTHON ?= python3
BCF_EVIDENCE_DIR ?= .artifacts/bcf

.PHONY: governance-truthfulness release-check architecture-context-membership architecture-cqrs-side architecture-duplication architecture-import-boundaries architecture-layer-membership architecture-module-size architecture-router-thinness architecture-test contract-test governance-exposure-scan governance-validate lint runtime-smoke security-dependency-audit security-review security-sbom security-secret-scan security-vulnerability-scan semantic-ownership test typecheck

governance-truthfulness:
	$(PYTHON) scripts/governance_truth.py --repo-root . --evidence-dir $(BCF_EVIDENCE_DIR)

architecture-context-membership:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-context-membership

architecture-cqrs-side:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-cqrs-side

architecture-duplication:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-duplication

architecture-import-boundaries:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-import-boundaries

architecture-layer-membership:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-layer-membership

architecture-module-size:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-module-size

architecture-router-thinness:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-router-thinness

architecture-test:
	@cd . && python3 .github/scripts/run_self_governance_gate.py architecture-test

contract-test:
	@cd . && python3 .github/scripts/run_self_governance_gate.py contract-test

governance-exposure-scan:
	@cd . && python3 scripts/check_governance_exposure.py --repo-root .

governance-validate:
	@cd . && python3 scripts/validate_governance_yaml.py --repo-root .

lint:
	@cd . && python3 .github/scripts/run_self_governance_gate.py lint

runtime-smoke:
	@cd . && BCF_EXECUTION_PROFILE=production python3 .github/scripts/run_self_governance_gate.py runtime-smoke

security-dependency-audit:
	@cd . && python3 .github/scripts/run_self_governance_gate.py security-dependency-audit

security-review:
	@cd . && BCF_EXECUTION_PROFILE=production python3 .github/scripts/run_self_governance_gate.py security-review

security-sbom:
	@cd . && python3 .github/scripts/run_self_governance_gate.py security-sbom

security-secret-scan:
	@cd . && python3 .github/scripts/run_self_governance_gate.py security-secret-scan

security-vulnerability-scan:
	@cd . && python3 .github/scripts/run_self_governance_gate.py security-vulnerability-scan

semantic-ownership:
	@cd . && python3 .github/scripts/run_self_governance_gate.py semantic-ownership

test:
	@cd . && python3 .github/scripts/run_self_governance_gate.py test

typecheck:
	@cd . && python3 .github/scripts/run_self_governance_gate.py typecheck

release-check:
	@mkdir -p $(BCF_EVIDENCE_DIR)
	@session="$$($(PYTHON) scripts/preflight_governance.py --repo-root . --mode release --python $(PYTHON) --artifact-root $(BCF_EVIDENCE_DIR) --expected-producer local --format text | tail -n 1)"; \
	session_dir="$${session%/evidence-session.json}"; \
	for gate in architecture-context-membership architecture-cqrs-side architecture-duplication architecture-import-boundaries architecture-layer-membership architecture-module-size architecture-router-thinness architecture-test contract-test governance-exposure-scan governance-validate lint runtime-smoke security-dependency-audit security-review security-sbom security-secret-scan security-vulnerability-scan semantic-ownership test typecheck; do \
		$(PYTHON) scripts/governance_evidence.py --repo-root . run --gate $$gate --output "$$session_dir/$$gate" --python $(PYTHON) --session-manifest "$$session" || exit $$?; \
	done; \
	$(PYTHON) scripts/governance_truth.py --repo-root . --evidence-dir $(BCF_EVIDENCE_DIR)
