{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "retention_policy", "entries"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "generated_at_utc", "status", "path"],
      "properties": {
        "kind": { "type": "string", "const": "phase_history" },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generated_at_utc": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "purpose"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "build_block",
          "status",
          "outcome",
          "summary",
          "validation",
          "archived_artifacts"
        ],
        "properties": {
          "phase_id": { "type": "string", "pattern": "^P[0-9]+$" },
          "build_block": { "type": "string", "minLength": 1 },
          "release_train": { "type": "string", "minLength": 1 },
          "retention_source": { "type": "string", "enum": ["archive", "git_history"] },
          "retention_ref": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["completed", "verified", "closed", "abandoned"] },
          "outcome": { "type": "string", "minLength": 1 },
          "summary": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "validation": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "archived_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                "git_commit": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
