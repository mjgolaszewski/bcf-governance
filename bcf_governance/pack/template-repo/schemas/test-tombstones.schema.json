{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "entries"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "status", "path"],
      "properties": {
        "kind": {"const": "test_tombstone_registry"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "active"},
        "path": {"const": "governance/test-tombstones.yml"}
      }
    },
    "schema_version": {"const": "1.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["removed_node", "removed_in_phase", "source_commit", "reason", "replacement_owner", "replacement_tests"],
        "properties": {
          "removed_node": {"type": "string", "minLength": 1},
          "removed_in_phase": {"type": "string", "pattern": "^P[0-9]+$"},
          "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "reason": {"type": "string", "minLength": 1},
          "replacement_owner": {"type": "string", "minLength": 1},
          "replacement_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
