{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "settings", "claim_dependencies", "security_impact_categories", "workflow_contract", "gate_overrides", "provenance"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "generated_at_utc", "status", "path"],
      "properties": {
        "kind": {"const": "evidence_integrity_policy"},
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "generated_at_utc": {"type": "string", "minLength": 1},
        "status": {"const": "active"},
        "path": {"const": "governance/evidence-policy.yml"}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_terminal_states", "computed_states", "default_binding", "tree_independent_allowlist", "require_negative_control_for_required_gates", "required_test_defaults"],
      "properties": {
        "authored_terminal_states": {"type": "array", "maxItems": 0},
        "computed_states": {"type": "array", "const": ["verified", "closed"]},
        "default_binding": {"const": "exact_tree"},
        "tree_independent_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "require_negative_control_for_required_gates": {"const": true},
        "required_test_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_collected", "min_executed", "max_skipped"],
          "properties": {
            "min_collected": {"type": "integer", "minimum": 1},
            "min_executed": {"type": "integer", "minimum": 1},
            "max_skipped": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "claim_dependencies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "security_impact_categories": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "workflow_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "required_events"],
      "properties": {
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_events": {"type": "array", "minItems": 1, "items": {"enum": ["pull_request", "push", "workflow_call", "workflow_dispatch", "schedule"]}},
        "gate_resolvers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "workflow_path", "job_id", "matrix_key", "script_path", "gate_contract_path", "profile_path"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
              "kind": {"const": "canonical_contract_shards"},
              "workflow_path": {"type": "string", "minLength": 1},
              "job_id": {"type": "string", "minLength": 1},
              "matrix_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
              "script_path": {"type": "string", "minLength": 1},
              "gate_contract_path": {"type": "string", "minLength": 1},
              "profile_path": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "gate_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_kind": {"enum": ["gate", "test_suite", "runtime_health", "security_review", "finding_verification"]},
          "negative_controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "mutation", "oracle"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "mutation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path"],
                  "oneOf": [
                    {"required": ["search", "replace"]},
                    {"required": ["search", "replace_base64"]},
                    {"required": ["yaml_path", "value"]}
                  ],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "search": {"type": "string", "minLength": 1},
                    "replace": {"type": "string"},
                    "replace_base64": {"type": "string", "minLength": 1},
                    "yaml_path": {"type": "string", "minLength": 1},
                    "value": {}
                  }
                },
                "oracle": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "exit_codes", "stream", "regex"],
                      "properties": {
                        "kind": {"const": "diagnostic"},
                        "exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 125}},
                        "stream": {"enum": ["stdout", "stderr"]},
                        "regex": {"type": "string", "minLength": 1}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "node_ids"],
                      "properties": {
                        "kind": {"const": "test_node_failure"},
                        "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                      }
                    }
                  ]
                }
              }
            }
          },
          "test_contract": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_collected": {"type": "integer", "minimum": 1},
              "min_executed": {"type": "integer", "minimum": 1},
              "max_skipped": {"type": "integer", "minimum": 0},
              "junit_xml": {"type": "string", "minLength": 1},
              "expected_node_manifest": {"type": "string", "minLength": 1},
              "expected_nodes_mode": {"enum": ["contains", "exact"]},
              "artifact_binding": {"const": "non_authoritative_until_captured"}
            }
          },
          "environment_assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "operator", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "operator": {"const": "equals"},
                "value": {"type": ["string", "number", "boolean"]}
              }
            }
          },
          "output_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "media_type", "authority"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "media_type": {"type": "string", "minLength": 1},
                "authority": {"const": "non_authoritative_until_captured"}
              }
            }
          },
          "freshness_limit_seconds": {"type": "integer", "minimum": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_same_actor_policy", "regulated_independent_severities", "regulated_requires_attestation", "trusted_verifier_keys", "permitted_risk_authorities"],
      "properties": {
        "standard_same_actor_policy": {"enum": ["allow", "warn", "fail"]},
        "regulated_independent_severities": {"type": "array", "items": {"enum": ["critical", "high", "medium", "low"]}},
        "regulated_requires_attestation": {"type": "boolean"},
        "trusted_verifier_keys": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "permitted_risk_authorities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
