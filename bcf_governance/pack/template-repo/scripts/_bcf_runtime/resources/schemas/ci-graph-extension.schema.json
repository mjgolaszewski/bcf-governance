{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcf-governance.invalid/schemas/ci-graph-extension.schema.json",
  "title": "BCF CI graph extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "extension", "artifacts", "conditions", "commands", "step_components", "workflows", "jobs"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "id", "version", "status", "path"],
      "properties": {
        "kind": {"const": "ci_graph_extension"},
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"const": "active"},
        "path": {"type": "string", "pattern": "^governance/ci-extensions/[A-Za-z0-9._-]+\\.ya?ml$"}
      }
    },
    "schema_version": {"const": "1.0"},
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "rationale", "attachment_point", "applicability", "required_controls"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
        "owner": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "attachment_point": {"enum": ["preflight", "evidence-lane", "before-truth", "after-truth", "exact-main-producer", "trusted-control", "scheduled-lane", "release-role"]},
        "applicability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pull_request", "pull_request_target", "push", "workflow_call", "workflow_dispatch", "workflow_run", "schedule", "repository_dispatch"]}},
        "required_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative", "topology", "cleanup"],
          "properties": {
            "positive": {"$ref": "#/$defs/controlIds"},
            "negative": {"$ref": "#/$defs/controlIds"},
            "topology": {"$ref": "#/$defs/controlIds"},
            "cleanup": {"$ref": "#/$defs/controlIds"}
          }
        }
      }
    },
    "artifacts": {"type": "object"},
    "conditions": {"type": "object"},
    "commands": {"type": "object"},
    "step_components": {"type": "object"},
    "workflows": {"type": "array"},
    "jobs": {"type": "array"}
  },
  "$defs": {
    "controlIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"}
    }
  }
}
