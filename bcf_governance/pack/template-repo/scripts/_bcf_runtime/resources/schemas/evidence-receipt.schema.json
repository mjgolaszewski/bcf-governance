{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Schema 3.0 adds dependency-scoped multi-claim evidence. Schema 2.0 remains readable only with exact-subject legacy semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_id", "gate_id", "producer", "invocation", "subject", "artifacts", "observations", "behavioral_probes", "result", "started_at", "timestamp"],
  "properties": {
    "schema_version": {"enum": ["2.0", "3.0"]},
    "kind": {"enum": ["gate", "test_suite", "runtime_health", "security_review", "finding_verification", "phase_closeout", "release", "detector_qualification"]},
    "evidence_id": {"type": "string", "minLength": 1, "description": "Unique within the exact subject and evidence session; filenames and directories do not provide identity."},
    "gate_id": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependency_manifest": {"$ref": "#/$defs/dependencyManifest"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "qualifications": {"type": "object", "additionalProperties": {"$ref": "#/$defs/qualification"}},
    "qualification_refs": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "evidence_id", "artifact_sha256"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "model", "service", "workflow"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "environment", "workflow"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "environment": {"type": "object"},
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "path", "job", "run_id", "run_attempt"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "job": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "run_attempt": {"type": "string", "minLength": 1},
            "matrix": {"type": "object", "description": "Canonical execution partition. Absence is normalized to an empty object only by the receipt-admission decoder."}
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "execution_tree_sha", "binding", "tracked_clean", "untracked_clean", "status_porcelain_sha256"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "execution_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "binding": {"enum": ["exact_tree", "tree_independent"]},
        "tracked_clean": {"const": true},
        "untracked_clean": {"const": true},
        "status_porcelain_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "observations": {"type": "object"},
    "behavioral_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mutation_applied", "oracle", "oracle_observation", "observed_exit_code", "raw_artifacts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mutation_applied": {"const": true},
          "oracle": {"type": "object"},
          "oracle_observation": {"type": "object"},
          "observed_exit_code": {"type": "integer"},
          "raw_artifacts": {"type": "object"}
        }
      }
    },
    "result": {"enum": ["passed", "failed"]},
    "freshness_limit_seconds": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependencyManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "claim_model_version", "claim_model_sha256", "complete", "claims", "classes", "claim_dependencies"],
      "properties": {
        "contract_version": {"const": "3.0"},
        "claim_model_version": {"const": "1.0"},
        "claim_model_sha256": {"$ref": "#/$defs/sha256"},
        "complete": {"const": true},
        "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "classes": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["class", "patterns", "paths", "fingerprint"],
            "properties": {
              "class": {"enum": ["subject", "detector", "test_population", "toolchain", "trust"]},
              "patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "claim_dependencies": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "array", "minItems": 5, "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["class", "patterns", "paths", "fingerprint"],
              "properties": {
                "class": {"enum": ["subject", "detector", "test_population", "toolchain", "trust"]},
                "patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "fingerprint": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "satisfied", "fingerprint", "control_ids"],
      "properties": {
        "scope": {"enum": ["detector", "subject"]},
        "satisfied": {"type": "boolean"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "control_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0"}, "kind": {"not": {"const": "release"}}}, "required": ["schema_version", "kind"]},
      "then": {"properties": {"behavioral_probes": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": "3.0"}}, "required": ["schema_version"]},
      "then": {"required": ["claims", "dependency_manifest", "qualification_refs"]}
    }
  ]
}
